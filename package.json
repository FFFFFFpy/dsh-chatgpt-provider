{
  "name": "@local/chatgpt-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Use a ChatGPT plan as a model provider: Sign in with ChatGPT, list the account's models, and stream Responses API calls through the OAuth grant.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./assets/*": "./lib/assets/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/assets",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "chatgpt",
    "sign-in-with-chatgpt",
    "openai",
    "provider"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
